{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "erasableSyntaxOnly": true,
    "types": ["node", "vite/client"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["api/**/*.ts", "chain/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "tests/**/*.ts", "playwright.config.ts", "vitest.config.ts"]
}
