# Build time. Leave blank for copy/download only. Set a team-confirmed, monitored mailbox to expose the mailto action.
NEXT_PUBLIC_CONTACT_EMAIL=
# Build time. Keep false for the interim text mark. Set true only after wordmark rights clearance.
NEXT_PUBLIC_USE_WORDMARK=false
# Optional local QA. Absolute path to an installed Chromium binary.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Optional local QA. Origin serving the production export, for example http://127.0.0.1:3000.
PLAYWRIGHT_BASE_URL=
